# Biến môi trường cho EC2 — KHÔNG commit file .env thật.
# deploy.sh sinh ra .env trên server từ GitHub Actions secret (PRODUCTION_ENV_FILE).

# --- PostgreSQL container ---
POSTGRES_USER=bepnhaminh
POSTGRES_PASSWORD=THAY_BANG_MAT_KHAU_MANH
POSTGRES_DB=bepnhaminh

# --- API ---
# Trỏ vào service postgres trong cùng network của docker compose
DATABASE_URL=postgresql://bepnhaminh:THAY_BANG_MAT_KHAU_MANH@postgres:5432/bepnhaminh?schema=public
PORT=3000
NODE_ENV=production

JWT_ACCESS_SECRET=THAY_BANG_CHUOI_NGAU_NHIEN_32_KY_TU
JWT_REFRESH_SECRET=THAY_BANG_CHUOI_NGAU_NHIEN_32_KY_TU_KHAC
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGIN=https://bepnhaminh.app

AWS_REGION=ap-southeast-1
S3_BUCKET=bepnhaminh-prod-images

# --- Image ---
API_IMAGE=ghcr.io/CHU_CA_NHAN_OR_TO_CHUC/bepnhaminh/api:latest
