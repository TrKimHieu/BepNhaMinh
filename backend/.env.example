NODE_ENV=development
PORT=3000

# PostgreSQL local (khớp với infrastructure/docker-compose.dev.yml)
DATABASE_URL="postgresql://bepnhaminh:bepnhaminh@localhost:5432/bepnhaminh?schema=public"

# Bắt buộc >= 32 ký tự. Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="dev-access-secret-thay-bang-chuoi-ngau-nhien-32-ky-tu"
JWT_REFRESH_SECRET="dev-refresh-secret-thay-bang-chuoi-ngau-nhien-32-ky-tu"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# "*" cho dev, production phải liệt kê domain thật: "https://bepnhaminh.app"
CORS_ORIGIN="*"

# AWS S3 chứa ảnh món ăn (dùng presigned URL, app không upload qua server)
AWS_REGION="ap-southeast-1"
S3_BUCKET="bepnhaminh-dev-images"
